# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1  # default, override if needed

# ── Hindsight Memory (Cloud) ───────────────────────────────────────────────────
# Get your API key and base URL from: https://ui.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://your-instance.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# ── Backend ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# ── Frontend ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000  # set if not using Next.js rewrite proxy
